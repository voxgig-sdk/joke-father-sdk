# Entity: joke

main: kit: entity: joke: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: true
      short: "Unique identifier for the joke"
      type: "`$STRING`"
    }
    {
      name: "joke"
      req: true
      short: "The complete joke text"
      type: "`$STRING`"
    }
    {
      name: "punchline"
      req: false
      short: "The punchline/answer part of the joke"
      type: "`$STRING`"
    }
    {
      name: "setup"
      req: false
      short: "The setup/question part of the joke"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "joke"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/jokes/random"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "jokes"
            }
            {
              lit: "random"
            }
          ]
          select: {
            "$action": "random"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
